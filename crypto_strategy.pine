//@version=5
strategy("Institutional 5m Crypto Strategy v4 [Jules]", overlay=true, process_orders_on_close=true, calc_on_every_tick=false, initial_capital=1000, commission_type=strategy.commission.percent, commission_value=0.04, default_qty_type=strategy.percent_of_equity, default_qty_value=15)

// ==========================================
// 1. INPUTS & CONFIGURATION
// ==========================================
grp_ind = "Indicators"
len_ema_1 = input.int(50, "EMA 1 Length", group=grp_ind)
len_ema_2 = input.int(100, "EMA 2 Length", group=grp_ind)
len_ema_3 = input.int(200, "EMA 3 Length", group=grp_ind)

grp_filt = "Entry Filters"
use_vol = input.bool(true, "Use Volume Spike?", group=grp_filt)
vol_mult = input.float(1.5, "Vol Multiplier", group=grp_filt)
use_rsi = input.bool(true, "Use RSI Rejection?", group=grp_filt)

grp_sess = "Time / Session Filter"
use_session = input.bool(false, "Trade Only Specific Session?", group=grp_sess, tooltip="Crypto trades 24/7, but 'Smart Money' moves often happen during London/NY hours. Enable this to filter out low-volume Asian chop.")
session_time = input.session("0800-1600", "Session Time (UTC)", group=grp_sess, tooltip="Format: HHMM-HHMM. Example: 0800-1600 for London/NY Overlap")

grp_piv = "Market Structure (Pivots)"
left_bars = input.int(5, "Pivot Left Bars (Faster)", group=grp_piv)
right_bars = input.int(5, "Pivot Right Bars", group=grp_piv)

grp_risk = "Risk Management"
rr_ratio = input.float(1.5, "Risk:Reward Ratio (Conservative)", step=0.1, group=grp_risk)
use_be = input.bool(true, "Move to Breakeven?", group=grp_risk)
be_trigger = input.float(0.8, "Trigger BE at R:R", step=0.1, tooltip="Move SL to Entry when price reaches 0.8x Risk")
use_partial = input.bool(true, "Take Partial Profit?", group=grp_risk)
partial_ratio = input.float(1.0, "Partial TP at R:R", step=0.1)

// ==========================================
// 2. INDICATORS
// ==========================================
// Triple EMA Cloud for Trend Strength
ema_1 = ta.ema(close, len_ema_1)
ema_2 = ta.ema(close, len_ema_2)
ema_3 = ta.ema(close, len_ema_3)

// Strong Trend Definition: Perfect Alignment
trend_strong_bull = close > ema_1 and ema_1 > ema_2 and ema_2 > ema_3
trend_strong_bear = close < ema_1 and ema_1 < ema_2 and ema_2 < ema_3

// Volume Spike
vol_sma = ta.sma(volume, 20)
vol_ok = use_vol ? (volume > vol_sma * vol_mult) : true

// RSI (Momentum)
rsi = ta.rsi(close, 14)
rsi_long_ok = use_rsi ? (rsi > 40 and rsi < 65) : true
rsi_short_ok = use_rsi ? (rsi < 60 and rsi > 35) : true

// Time Filter
in_session = use_session ? not na(time(timeframe.period, session_time)) : true

// Pivots
ph = ta.pivothigh(high, left_bars, right_bars)
pl = ta.pivotlow(low, left_bars, right_bars)

var float last_ph = na
var float last_pl = na

if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

// ==========================================
// 3. SIGNAL GENERATION
// ==========================================

// --- Signal 1: Break of Structure (BOS) with Trend ---
// Faster BOS: Reduced left_bars to 5.
bos_long = trend_strong_bull and not na(last_ph) and ta.crossover(close, last_ph)
bos_short = trend_strong_bear and not na(last_pl) and ta.crossunder(close, last_pl)

valid_long = bos_long and vol_ok and rsi_long_ok and in_session
valid_short = bos_short and vol_ok and rsi_short_ok and in_session

// ==========================================
// 4. EXECUTION & RISK MANAGEMENT
// ==========================================
var float trade_entry = na
var float trade_sl = na
var float trade_tp = na
var bool trade_be_moved = false
var bool trade_partial_taken = false

// --- ENTRY ---
if strategy.position_size == 0
    if valid_long
        // Set SL below the breakout candle Low OR the EMA 50 (dynamic support)
        float swing_low = ta.lowest(low, right_bars)
        trade_sl := math.min(swing_low, close * 0.995)
        trade_entry := close
        float risk = trade_entry - trade_sl

        // Safety: Minimum SL
        if risk < close * 0.002
            risk := close * 0.002
            trade_sl := close - risk

        trade_tp := trade_entry + (risk * rr_ratio)
        trade_be_moved := false
        trade_partial_taken := false

        strategy.entry("Long", strategy.long, comment="L-BOS")
        strategy.exit("Exit Long Full", "Long", stop=trade_sl, limit=trade_tp)

    if valid_short
        float swing_high = ta.highest(high, right_bars)
        trade_sl := math.max(swing_high, close * 1.005)
        trade_entry := close
        float risk = trade_sl - trade_entry

        if risk < close * 0.002
            risk := close * 0.002
            trade_sl := close + risk

        trade_tp := trade_entry - (risk * rr_ratio)
        trade_be_moved := false
        trade_partial_taken := false

        strategy.entry("Short", strategy.short, comment="S-BOS")
        strategy.exit("Exit Short Full", "Short", stop=trade_sl, limit=trade_tp)

// --- MANAGEMENT (Partial TP & Breakeven) ---

// Current Risk Calculation
float current_risk_long = trade_entry - trade_sl
float current_risk_short = trade_sl - trade_entry

// LONG MANAGEMENT
if strategy.position_size > 0
    // 1. Partial TP
    if use_partial and not trade_partial_taken
        if high >= trade_entry + (current_risk_long * partial_ratio)
            strategy.exit("Exit Long Partial", "Long", qty_percent=50, limit=close, comment_profit="TP-1")
            trade_partial_taken := true
            // Move SL to BE immediately after Partial
            trade_sl := trade_entry * 1.0005
            trade_be_moved := true

    // 2. Breakeven (if not triggered by Partial)
    if use_be and not trade_be_moved
        if high >= trade_entry + (current_risk_long * be_trigger)
            trade_sl := trade_entry * 1.0005
            trade_be_moved := true

    // Persist Remaining Exit
    strategy.exit("Exit Long Full", "Long", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP-Final")

// SHORT MANAGEMENT
if strategy.position_size < 0
    // 1. Partial TP
    if use_partial and not trade_partial_taken
        if low <= trade_entry - (current_risk_short * partial_ratio)
            strategy.exit("Exit Short Partial", "Short", qty_percent=50, limit=close, comment_profit="TP-1")
            trade_partial_taken := true
            trade_sl := trade_entry * 0.9995
            trade_be_moved := true

    // 2. Breakeven
    if use_be and not trade_be_moved
        if low <= trade_entry - (current_risk_short * be_trigger)
            trade_sl := trade_entry * 0.9995
            trade_be_moved := true

    // Persist Remaining Exit
    strategy.exit("Exit Short Full", "Short", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP-Final")

// ==========================================
// 5. VISUALIZATION
// ==========================================
plot(ema_1, "EMA 50", color=color.yellow)
plot(ema_2, "EMA 100", color=color.orange)
plot(ema_3, "EMA 200", color=color.blue, linewidth=2)

// Paint candles where trend is perfect
barcolor(trend_strong_bull ? color.green : (trend_strong_bear ? color.red : na))

// Background for Session
bgcolor(in_session ? color.new(color.blue, 95) : na, title="Active Session")
