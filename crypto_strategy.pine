//@version=5
strategy("Institutional 5m Crypto Strategy v3 [Jules]", overlay=true, process_orders_on_close=true, calc_on_every_tick=false, initial_capital=1000, commission_type=strategy.commission.percent, commission_value=0.04, default_qty_type=strategy.percent_of_equity, default_qty_value=15)

// ==========================================
// 1. INPUTS & CONFIGURATION
// ==========================================
grp_ind = "Indicators"
len_ema_1 = input.int(50, "EMA 1 Length", group=grp_ind)
len_ema_2 = input.int(100, "EMA 2 Length", group=grp_ind)
len_ema_3 = input.int(200, "EMA 3 Length", group=grp_ind)

grp_filt = "Entry Filters"
use_vol = input.bool(true, "Use Volume Spike?", group=grp_filt)
vol_mult = input.float(1.5, "Vol Multiplier", group=grp_filt)
use_rsi = input.bool(true, "Use RSI Rejection?", group=grp_filt)

grp_piv = "Market Structure (Pivots)"
left_bars = input.int(15, "Pivot Left Bars (Major)", group=grp_piv)
right_bars = input.int(5, "Pivot Right Bars (Fast)", group=grp_piv)

grp_risk = "Risk Management"
rr_ratio = input.float(2.5, "Risk:Reward Ratio", step=0.1, group=grp_risk)
use_be = input.bool(true, "Move to Breakeven?", group=grp_risk)
be_trigger = input.float(1.0, "Trigger BE at R:R", step=0.1, tooltip="Move SL to Entry when price reaches 1.0x Risk")

// ==========================================
// 2. INDICATORS
// ==========================================
// Triple EMA Cloud for Trend Strength
ema_1 = ta.ema(close, len_ema_1)
ema_2 = ta.ema(close, len_ema_2)
ema_3 = ta.ema(close, len_ema_3)

// Strong Trend Definition: Perfect Alignment
trend_strong_bull = close > ema_1 and ema_1 > ema_2 and ema_2 > ema_3
trend_strong_bear = close < ema_1 and ema_1 < ema_2 and ema_2 < ema_3

// Volume Spike
vol_sma = ta.sma(volume, 20)
vol_ok = use_vol ? (volume > vol_sma * vol_mult) : true

// RSI
rsi = ta.rsi(close, 14)
// RSI Rejection Logic:
// Long: RSI was oversold (<35) recently and is now recovering? OR just healthy momentum (>45).
// User had losses, likely due to catching falling knives.
// New Logic: Only enter if RSI is > 40 (momentum is there) and < 65 (room to grow).
rsi_long_ok = use_rsi ? (rsi > 40 and rsi < 65) : true
rsi_short_ok = use_rsi ? (rsi < 60 and rsi > 35) : true

// Pivots
ph = ta.pivothigh(high, left_bars, right_bars)
pl = ta.pivotlow(low, left_bars, right_bars)

var float last_ph = na
var float last_pl = na

if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

// ==========================================
// 3. SIGNAL GENERATION
// ==========================================

// --- Signal 1: Break of Structure (BOS) with Trend ---
// Price breaks the last Pivot High in a Bull Trend
bos_long = trend_strong_bull and not na(last_ph) and ta.crossover(close, last_ph)
// Price breaks the last Pivot Low in a Bear Trend
bos_short = trend_strong_bear and not na(last_pl) and ta.crossunder(close, last_pl)

// --- Signal 2: Pullback to Value (Dynamic Support) ---
// Price touches EMA 50/100 area in a strong trend and rejects
// (Simplified to just BOS for now to reduce noise as requested)

valid_long = bos_long and vol_ok and rsi_long_ok
valid_short = bos_short and vol_ok and rsi_short_ok

// ==========================================
// 4. EXECUTION & RISK MANAGEMENT
// ==========================================
var float trade_entry = na
var float trade_sl = na
var float trade_tp = na
var bool trade_be_moved = false

// --- ENTRY ---
if strategy.position_size == 0
    if valid_long
        // Set SL below the breakout candle Low OR the EMA 50 (dynamic support)
        // A tighter SL improves R:R. Let's use the Low of the breakout sequence (Pivot Right Bars lookback)
        float swing_low = ta.lowest(low, right_bars)
        trade_sl := math.min(swing_low, close * 0.995) // Max 0.5% risk per trade logic could be here
        trade_entry := close
        float risk = trade_entry - trade_sl

        // Safety: Minimum SL distance to avoid noise
        if risk < close * 0.002
            risk := close * 0.002
            trade_sl := close - risk

        trade_tp := trade_entry + (risk * rr_ratio)
        trade_be_moved := false

        strategy.entry("Long", strategy.long, comment="L-BOS")
        strategy.exit("Exit Long", "Long", stop=trade_sl, limit=trade_tp)

    if valid_short
        float swing_high = ta.highest(high, right_bars)
        trade_sl := math.max(swing_high, close * 1.005)
        trade_entry := close
        float risk = trade_sl - trade_entry

        if risk < close * 0.002
            risk := close * 0.002
            trade_sl := close + risk

        trade_tp := trade_entry - (risk * rr_ratio)
        trade_be_moved := false

        strategy.entry("Short", strategy.short, comment="S-BOS")
        strategy.exit("Exit Short", "Short", stop=trade_sl, limit=trade_tp)

// --- MANAGEMENT (Breakeven) ---
// If price moves X amount in our favor, move SL to Entry.
if strategy.position_size > 0 and use_be and not trade_be_moved
    float risk = trade_entry - trade_sl
    if high >= trade_entry + (risk * be_trigger)
        trade_sl := trade_entry * 1.0005 // Slight profit to cover fees
        trade_be_moved := true
        strategy.exit("Exit Long", "Long", stop=trade_sl, limit=trade_tp, comment_loss="BE", comment_profit="TP")
else if strategy.position_size > 0
    // Persist Exit
    strategy.exit("Exit Long", "Long", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP")

if strategy.position_size < 0 and use_be and not trade_be_moved
    float risk = trade_sl - trade_entry
    if low <= trade_entry - (risk * be_trigger)
        trade_sl := trade_entry * 0.9995 // Slight profit to cover fees
        trade_be_moved := true
        strategy.exit("Exit Short", "Short", stop=trade_sl, limit=trade_tp, comment_loss="BE", comment_profit="TP")
else if strategy.position_size < 0
    // Persist Exit
    strategy.exit("Exit Short", "Short", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP")

// ==========================================
// 5. VISUALIZATION
// ==========================================
plot(ema_1, "EMA 50", color=color.yellow)
plot(ema_2, "EMA 100", color=color.orange)
plot(ema_3, "EMA 200", color=color.blue, linewidth=2)

// Paint candles where trend is perfect
barcolor(trend_strong_bull ? color.green : (trend_strong_bear ? color.red : na))
