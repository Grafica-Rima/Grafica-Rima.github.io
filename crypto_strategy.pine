//@version=5
strategy("Institutional 5m Crypto Strategy v5 [Jules]", overlay=true, process_orders_on_close=true, calc_on_every_tick=false, initial_capital=1000, commission_type=strategy.commission.percent, commission_value=0.04, default_qty_type=strategy.percent_of_equity, default_qty_value=20)

// ==========================================
// 1. INPUTS & CONFIGURATION
// ==========================================
grp_ind = "Indicators"
len_ema_trend = input.int(200, "Trend EMA Length", group=grp_ind)
len_ema_pullback = input.int(50, "Pullback EMA Length", group=grp_ind)

grp_filt = "Entry Filters"
use_vol = input.bool(true, "Use Volume Spike?", group=grp_filt)
vol_mult = input.float(1.1, "Vol Multiplier (Relaxed)", group=grp_filt)
use_rsi = input.bool(true, "Use RSI Filter?", group=grp_filt)

grp_sess = "Time / Session Filter"
use_session = input.bool(false, "Trade Only Specific Session?", group=grp_sess, tooltip="Crypto trades 24/7. Enable to filter for London/NY volatility.")
session_time = input.session("0800-1600", "Session Time (UTC)", group=grp_sess)

grp_piv = "Market Structure (Pivots)"
left_bars = input.int(3, "Pivot Left Bars (Fast)", group=grp_piv)
right_bars = input.int(3, "Pivot Right Bars (Fast)", group=grp_piv)

grp_risk = "Risk Management"
rr_ratio = input.float(1.5, "Risk:Reward Ratio", step=0.1, group=grp_risk)
max_sl_percent = input.float(1.5, "Max Stop Loss %", step=0.1, group=grp_risk, tooltip="Hard cap on SL distance to prevent large losses")
use_be = input.bool(true, "Move to Breakeven?", group=grp_risk)
be_trigger = input.float(0.8, "Trigger BE at R:R", step=0.1)

// ==========================================
// 2. INDICATORS
// ==========================================
// EMAs
ema_trend = ta.ema(close, len_ema_trend)      // 200 EMA
ema_pullback = ta.ema(close, len_ema_pullback) // 50 EMA

// Trend Direction (Simplified)
// Bullish: Price > 200 EMA
// Bearish: Price < 200 EMA
is_uptrend = close > ema_trend
is_downtrend = close < ema_trend

// Volume Spike
vol_sma = ta.sma(volume, 20)
vol_ok = use_vol ? (volume > vol_sma * vol_mult) : true

// RSI (Relaxed)
rsi = ta.rsi(close, 14)
rsi_long_ok = use_rsi ? (rsi > 30 and rsi < 70) : true
rsi_short_ok = use_rsi ? (rsi < 70 and rsi > 30) : true

// Time Filter
in_session = use_session ? not na(time(timeframe.period, session_time)) : true

// Pivots
ph = ta.pivothigh(high, left_bars, right_bars)
pl = ta.pivotlow(low, left_bars, right_bars)

var float last_ph = na
var float last_pl = na

if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

// ==========================================
// 3. SIGNAL GENERATION
// ==========================================

// --- Entry Type 1: Break of Structure (BOS) ---
bos_long = is_uptrend and not na(last_ph) and ta.crossover(close, last_ph)
bos_short = is_downtrend and not na(last_pl) and ta.crossunder(close, last_pl)

// --- Entry Type 2: EMA Pullback (Bounce) ---
// Price dips into EMA 50 area and closes bullishly
// Long: Low touched EMA 50, but Close > Open (Green Candle)
pullback_long = is_uptrend and low <= ema_pullback and close > open and close > ema_pullback
// Short: High touched EMA 50, but Close < Open (Red Candle)
pullback_short = is_downtrend and high >= ema_pullback and close < open and close < ema_pullback

// Combined Signals
valid_long = (bos_long or pullback_long) and vol_ok and rsi_long_ok and in_session
valid_short = (bos_short or pullback_short) and vol_ok and rsi_short_ok and in_session

// ==========================================
// 4. EXECUTION & RISK MANAGEMENT
// ==========================================
var float trade_entry = na
var float trade_sl = na
var float trade_tp = na
var bool trade_be_moved = false

// --- ENTRY ---
if strategy.position_size == 0
    if valid_long
        // SL Logic: Recent Swing Low OR Low of Entry Candle
        float swing_low = ta.lowest(low, right_bars + 1)
        float structural_sl = math.min(swing_low, low)

        // Cap SL at Max %
        float max_sl_price = close * (1 - max_sl_percent / 100)
        trade_sl := math.max(structural_sl, max_sl_price)

        trade_entry := close
        float risk = trade_entry - trade_sl

        // Min risk check
        if risk < close * 0.001
            risk := close * 0.001
            trade_sl := close - risk

        trade_tp := trade_entry + (risk * rr_ratio)
        trade_be_moved := false

        strategy.entry("Long", strategy.long, comment=bos_long ? "L-BOS" : "L-Pullback")
        strategy.exit("Exit Long", "Long", stop=trade_sl, limit=trade_tp)

    if valid_short
        float swing_high = ta.highest(high, right_bars + 1)
        float structural_sl = math.max(swing_high, high)

        float max_sl_price = close * (1 + max_sl_percent / 100)
        trade_sl := math.min(structural_sl, max_sl_price)

        trade_entry := close
        float risk = trade_sl - trade_entry

        if risk < close * 0.001
            risk := close * 0.001
            trade_sl := close + risk

        trade_tp := trade_entry - (risk * rr_ratio)
        trade_be_moved := false

        strategy.entry("Short", strategy.short, comment=bos_short ? "S-BOS" : "S-Pullback")
        strategy.exit("Exit Short", "Short", stop=trade_sl, limit=trade_tp)

// --- MANAGEMENT (Breakeven) ---
if strategy.position_size > 0 and use_be and not trade_be_moved
    float risk = trade_entry - trade_sl
    if high >= trade_entry + (risk * be_trigger)
        trade_sl := trade_entry * 1.0005
        trade_be_moved := true
        strategy.exit("Exit Long", "Long", stop=trade_sl, limit=trade_tp, comment_loss="BE", comment_profit="TP")
else if strategy.position_size > 0
    strategy.exit("Exit Long", "Long", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP")

if strategy.position_size < 0 and use_be and not trade_be_moved
    float risk = trade_sl - trade_entry
    if low <= trade_entry - (risk * be_trigger)
        trade_sl := trade_entry * 0.9995
        trade_be_moved := true
        strategy.exit("Exit Short", "Short", stop=trade_sl, limit=trade_tp, comment_loss="BE", comment_profit="TP")
else if strategy.position_size < 0
    strategy.exit("Exit Short", "Short", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP")

// ==========================================
// 5. VISUALIZATION
// ==========================================
plot(ema_trend, "Trend EMA 200", color=color.blue, linewidth=2)
plot(ema_pullback, "Pullback EMA 50", color=color.orange)

// Paint signals
bgcolor(valid_long ? color.new(color.green, 80) : na, title="Long Signal")
bgcolor(valid_short ? color.new(color.red, 80) : na, title="Short Signal")
