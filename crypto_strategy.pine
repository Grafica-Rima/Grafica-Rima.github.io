//@version=5
strategy("Institutional 5m Crypto Strategy v2 [Jules]", overlay=true, process_orders_on_close=true, calc_on_every_tick=false, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ==========================================
// 1. INPUTS & CONFIGURATION
// ==========================================
grp_ind = "Indicators"
len_ema_fast = input.int(50, "Fast EMA Length", group=grp_ind)
len_ema_slow = input.int(200, "Slow EMA Length", group=grp_ind)
len_vol = input.int(20, "Volume SMA Length", group=grp_ind)
vol_mult = input.float(1.5, "Volume Spike Multiplier", group=grp_ind, step=0.1)

grp_filt = "Filters (ADX & RSI)"
use_adx = input.bool(true, "Use ADX Filter?", group=grp_filt)
len_adx = input.int(14, "ADX Length", group=grp_filt)
th_adx = input.int(20, "ADX Threshold", group=grp_filt)
len_rsi = input.int(14, "RSI Length", group=grp_filt)

grp_piv = "Pivots / Market Structure"
left_bars = input.int(10, "Pivot Left Bars (Stricter)", group=grp_piv)
right_bars = input.int(10, "Pivot Right Bars (Stricter)", group=grp_piv)

grp_risk = "Risk Management"
rr_ratio = input.float(2.0, "Risk:Reward Ratio", step=0.1, group=grp_risk)
use_fib_tp = input.bool(true, "Use Fib 1.618 as TP target?", group=grp_risk)

// ==========================================
// 2. INDICATORS
// ==========================================
// Moving Averages
ema_fast = ta.ema(close, len_ema_fast)
ema_slow = ta.ema(close, len_ema_slow)

// Volume
vol_sma = ta.sma(volume, len_vol)
vol_spike = volume > vol_sma * vol_mult

// RSI
rsi = ta.rsi(close, len_rsi)

// ADX
[di_plus, di_minus, adx] = ta.dmi(len_adx, len_adx)
is_trending = use_adx ? (adx > th_adx) : true

// Pivots for Market Structure
ph = ta.pivothigh(high, left_bars, right_bars)
pl = ta.pivotlow(low, left_bars, right_bars)

// Variable persistence for Market Structure
var float last_ph = na
var float last_pl = na
var float prev_ph = na
var float prev_pl = na

if not na(ph)
    prev_ph := last_ph
    last_ph := ph
if not na(pl)
    prev_pl := last_pl
    last_pl := pl

// ==========================================
// 3. PATTERN RECOGNITION (Institutional)
// ==========================================

// --- Fibonacci Retracement Logic ---
var float fib_entry_long = na
var float fib_entry_short = na

// Calculate Fib levels when we have a confirmed range
// Valid Up Swing: last_ph follows last_pl
if not na(ph) and not na(last_pl)
    float swing_range = ph - last_pl
    if swing_range > 0
        fib_entry_long := ph - (swing_range * 0.618)

// Valid Down Swing: last_pl follows last_ph
if not na(pl) and not na(last_ph)
    float swing_range = last_ph - pl
    if swing_range > 0
        fib_entry_short := pl + (swing_range * 0.618)

// ==========================================
// 4. SIGNAL GENERATION
// ==========================================

// Global Trend Filter (Stricter: EMAs must be aligned)
trend_bullish = ema_fast > ema_slow and close > ema_fast
trend_bearish = ema_fast < ema_slow and close < ema_fast

// RSI Filter (Avoid Overbought/Oversold entries)
rsi_bullish = rsi > 45 and rsi < 70
rsi_bearish = rsi < 55 and rsi > 30

// --- Long Signal Conditions ---
// Detect Break of Structure (BOS) - Breakout Strategy
long_bos = not na(last_ph) and ta.crossover(close, last_ph)
short_bos = not na(last_pl) and ta.crossunder(close, last_pl)

// Detect Fib Touch (Bounce Strategy)
long_fib_bounce = not na(fib_entry_long) and low <= fib_entry_long and close > fib_entry_long
short_fib_bounce = not na(fib_entry_short) and high >= fib_entry_short and close < fib_entry_short

// Combined Entry Triggers
// Must satisfy: Trend + RSI + ADX + Vol Spike + Pattern
valid_long_bos = trend_bullish and is_trending and rsi_bullish and long_bos and vol_spike
valid_short_bos = trend_bearish and is_trending and rsi_bearish and short_bos and vol_spike

valid_long_fib = trend_bullish and is_trending and rsi_bullish and long_fib_bounce and vol_spike
valid_short_fib = trend_bearish and is_trending and rsi_bearish and short_fib_bounce and vol_spike

// ==========================================
// 5. EXECUTION & RISK MANAGEMENT
// ==========================================

// Variables to store fixed SL/TP for the current trade
var float trade_sl = na
var float trade_tp = na

// --- ENTRY LOGIC ---
if strategy.position_size == 0
    // LONG
    if valid_long_bos or valid_long_fib
        float sl = na
        float risk = na
        float entry_price = close

        if valid_long_fib
            // For Fib entry, SL is below the swing low
            sl := not na(last_pl) ? last_pl : low * 0.99
            strategy.entry("Long Fib", strategy.long, comment="L-Fib")
        else
            // For BOS entry, SL is below the recent low
            sl := not na(last_pl) ? last_pl : low * 0.99
            strategy.entry("Long BOS", strategy.long, comment="L-BOS")

        // Set Risk Variables
        trade_sl := sl
        risk := entry_price - trade_sl
        // Min risk check to avoid zero div or tiny stops
        if risk <= (entry_price * 0.002)
            risk := entry_price * 0.005
            trade_sl := entry_price - risk

        trade_tp := use_fib_tp ? entry_price + (risk * 1.618) : entry_price + (risk * rr_ratio)
        strategy.exit("Exit Long", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP")

    // SHORT
    if valid_short_bos or valid_short_fib
        float sl = na
        float risk = na
        float entry_price = close

        if valid_short_fib
            sl := not na(last_ph) ? last_ph : high * 1.01
            strategy.entry("Short Fib", strategy.short, comment="S-Fib")
        else
            sl := not na(last_ph) ? last_ph : high * 1.01
            strategy.entry("Short BOS", strategy.short, comment="S-BOS")

        // Set Risk Variables
        trade_sl := sl
        risk := trade_sl - entry_price
        if risk <= (entry_price * 0.002)
            risk := entry_price * 0.005
            trade_sl := entry_price + risk

        trade_tp := use_fib_tp ? entry_price - (risk * 1.618) : entry_price - (risk * rr_ratio)
        strategy.exit("Exit Short", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP")

// --- EXIT LOGIC (PERSISTENCE) ---
if strategy.position_size > 0
    strategy.exit("Exit Long", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP")

if strategy.position_size < 0
    strategy.exit("Exit Short", stop=trade_sl, limit=trade_tp, comment_loss="SL", comment_profit="TP")

// ==========================================
// 6. VISUALIZATION
// ==========================================
plot(ema_fast, "EMA 50", color=color.yellow)
plot(ema_slow, "EMA 200", color=color.blue, linewidth=2)
plotshape(ph, style=shape.triangledown, location=location.abovebar, color=color.red, offset=-right_bars)
plotshape(pl, style=shape.triangleup, location=location.belowbar, color=color.green, offset=-right_bars)

// Background color for trend/ADX
bg_color = is_trending ? (trend_bullish ? color.new(color.green, 95) : (trend_bearish ? color.new(color.red, 95) : na)) : na
bgcolor(bg_color, title="Trend + ADX Active")
